{
  "rewrites": [
    { "source": "/publisher", "destination": "/app.html" },
    { "source": "/publisher/:path*", "destination": "/app.html" },
    { "source": "/retailer", "destination": "/app.html" },
    { "source": "/retailer/:path*", "destination": "/app.html" },
    { "source": "/admin", "destination": "/app.html" },
    { "source": "/admin/:path*", "destination": "/app.html" },

    { "source": "/p/:slug", "destination": "/app.html" },
    { "source": "/r/:slug", "destination": "/app.html" },

    { "source": "/home", "destination": "/app.html" },
    { "source": "/login", "destination": "/app.html" },
    { "source": "/apply", "destination": "/app.html" },
    { "source": "/apply/:path*", "destination": "/app.html" },
    { "source": "/pending", "destination": "/app.html" },
    { "source": "/rejected", "destination": "/app.html" },
    { "source": "/forgot-password", "destination": "/app.html" },
    { "source": "/reset-password", "destination": "/app.html" },
    { "source": "/verify-email", "destination": "/app.html" },
    { "source": "/auth/:path*", "destination": "/app.html" },
    { "source": "/error", "destination": "/app.html" },
    { "source": "/offline", "destination": "/app.html" },
    { "source": "/unauthorized", "destination": "/app.html" }
  ]
}
